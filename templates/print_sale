<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Товарная накладная № {{ sale.id }}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 14px;
            color: #000;
            margin: 0;
            padding: 20px;
            background: #fff;
        }
        .invoice-box {
            max-width: 800px;
            margin: auto;
            padding: 30px;
            border: 1px solid #eee;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.15);
        }
        .header {
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 20px;
            text-align: center;
        }
        .meta-info {
            margin-bottom: 20px;
        }
        .meta-info table {
            width: 100%;
            border-collapse: collapse;
        }
        .meta-info td {
            padding: 5px 0;
        }
        table.items-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            margin-bottom: 30px;
        }
        table.items-table th, table.items-table td {
            border: 1px solid #000;
            padding: 8px 12px;
            text-align: left;
        }
        table.items-table th {
            background-color: #f2f2f2;
        }
        .signatures {
            margin-top: 50px;
            width: 100%;
        }
        .signatures td {
            padding: 15px 0;
        }
        .no-print {
            text-align: center;
            margin-bottom: 20px;
        }
        .btn-print {
            padding: 10px 20px;
            font-size: 16px;
            background-color: #198754;
            color: white;
            border: none;
            cursor: pointer;
            border-radius: 4px;
        }
        .btn-print:hover {
            background-color: #157347;
        }
        @media print {
            .no-print {
                display: none;
            }
            .invoice-box {
                border: none;
                box-shadow: none;
                padding: 0;
            }
        }
    </style>
</head>
<body>

    <div class="no-print">
        <button class="btn-print" onclick="window.print()">🖨️ Печать накладной (A4)</button>
        <a href="{{ url_for('sales') }}" style="margin-left: 15px; text-decoration: none; color: #333;">← Назад к отгрузкам</a>
    </div>

    <div class="invoice-box">
        <div class="header">
            Товарная накладная № {{ sale.id }} от {{ sale.date }}
        </div>

        <div class="meta-info">
            <table>
                <tr>
                    <td style="width: 150px;"><strong>Поставщик:</strong></td>
                    <td>Складской учет (Склад)</td>
                </tr>
                <tr>
                    <td><strong>Покупатель:</strong></td>
                    <td>{{ sale.category }} — Клиент №{{ sale.client_number }}</td>
                </tr>
            </table>
        </div>

        <table class="items-table">
            <thead>
                <tr>
                    <th style="width: 50px; text-align: center;">№</th>
                    <th>Наименование товара</th>
                    <th style="width: 100px; text-align: center;">Ед. изм.</th>
                    <th style="width: 120px; text-align: right;">Количество</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td style="text-align: center;">1</td>
                    <td>{{ sale.item_name }}</td>
                    <td style="text-align: center;">{{ sale.unit }}</td>
                    <td style="text-align: right;">{{ sale.quantity }}</td>
                </tr>
            </tbody>
        </table>

        <div style="margin-bottom: 40px;">
            <strong>Всего наименований: 1, общая сумма: — </strong>
        </div>

        <table class="signatures">
            <tr>
                <td style="width: 50%;">
                    Отпустил (кладовщик): _________________ / _________________
                </td>
                <td style="width: 50%; text-align: right;">
                    Получил: _________________ / _________________
                </td>
            </tr>
        </table>
    </div>

</body>
</html>
